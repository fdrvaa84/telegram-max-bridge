#!/usr/bin/env bash
set -euo pipefail
umask 077
[[ $EUID == 0 ]] || { echo 'Начните команду с sudo telemax.'; exit 1; }
project=''
if [[ ${1:-} == --project ]]; then
    project=${2:?Укажите имя проекта}; shift 2
    [[ $project =~ ^[a-z][a-z0-9-]{0,19}$ ]] || { echo 'Некорректное имя проекта.'; exit 1; }
fi
root=/opt/telemax
data=/var/lib/telemax
owner=telemax
unit=telemax
if [[ -n $project ]]; then
    root=/opt/telemax/projects/$project
    data=/var/lib/telemax-projects/$project
    owner=telemax-$project
    unit=telemax-$project
fi
base=$root/current
[[ -d $base ]] || { echo 'Укажите установленный проект: sudo telemax --project ИМЯ status. Старая установка вызывается без имени.'; exit 1; }
# A project operation cannot race another operation or an installer.
if [[ ${TELEMAX_INSTALL_LOCKED:-} != 1 ]]; then
    install -d -m 700 -o root -g root /run/telemax
    exec 9>/run/telemax/install.lock
    flock -x 9
fi
if [[ ${TELEMAX_OPERATION_LOCKED:-} != "$unit" ]]; then
    exec 8>"$root/.operation.lock"
    flock -x 8
fi
export TELEMAX_OPERATION_LOCKED=$unit
export TELEMAX_PROJECT_PORT=3117
if [[ -n $project ]]; then
    TELEMAX_PROJECT_PORT=$(python3 /usr/local/lib/telemax/project.py port "$project")
fi
cmd=${1:-help}
shift || true
as_owner() { runuser -u "$owner" --preserve-environment -- "$base/venv/bin/python" "$base/app/manage.py" --config "$data/config.json" "$@"; }
case "$cmd" in
configure|clouds)
    was_active=false
    if systemctl is-active --quiet "$unit"; then was_active=true; fi
    systemctl stop "$unit"
    trap 'if [[ $was_active == true ]]; then systemctl start "$unit"; fi' EXIT
    as_owner "$cmd"
    ;;
pair)
    was_active=false
    if systemctl is-active --quiet "$unit"; then was_active=true; fi
    systemctl stop "$unit"
    trap 'if [[ $was_active == true ]]; then systemctl start "$unit"; fi' EXIT
    as_owner pair
    ;;
login)
    was_active=false
    if systemctl is-active --quiet "$unit"; then was_active=true; fi
    systemctl stop "$unit"
    trap 'if [[ $was_active == true ]]; then systemctl start "$unit"; fi' EXIT
    runuser -u "$owner" -- "$base/venv/bin/python" "$base/app/bridge.py" --config "$data/config.json" --login --enable
    ;;
start)
    runuser -u "$owner" -- "$base/venv/bin/python" -c 'from pathlib import Path; import sys; sys.path.insert(0,sys.argv[1]); from bridge import load_config; c=load_config(sys.argv[2]); sys.exit(0 if c.get("enabled") and c.get("max_owner_id") and c.get("telegram_owner_id") and (Path(c["state_dir"])/"telegram.session").exists() else "Сначала привяжите MAX и войдите в Telegram.")' "$base/app" "$data/config.json"
    systemctl enable --now "$unit"
    as_owner subscribe
    echo 'Передача запущена и включена после перезагрузки. Теперь проверьте живой обмен.'
    ;;
stop)
    systemctl disable --now "$unit"
    as_owner unsubscribe
    echo 'Передача остановлена. Сохранённые сообщения и вход не удалены.'
    ;;
restart)
    systemctl try-restart "$unit"
    ;;
status)
    as_owner status
    if systemctl is-active --quiet "$unit"; then echo 'Служба работает.'; else echo 'Служба остановлена.'; fi
    if systemctl is-enabled --quiet "$unit"; then echo 'Запуск после перезагрузки включён.'; else echo 'Запуск после перезагрузки выключен.'; fi
    ;;
logs)
    # Print only a fixed vocabulary, never arbitrary HTTP, media, or Telegram output.
    journalctl -u "$unit" --since '1 hour ago' --no-pager -o cat | "$base/venv/bin/python" -c '
import sys
labels={"source_read_pending":"Чтение Telegram отложено; сохранённая позиция не пропущена.","delivery_pending":"Отправка ожидает следующей попытки.","delivery_blocked":"Отправка остановлена: проверьте формат или права.","incoming_reply_pending":"Приём ответа не завершён; ожидается повтор от MAX.","choice_delivery_pending":"Вопрос о формате видео пока не доставлен.","callback_ack_pending":"Подтверждение выбора MAX отложено.","cloud_copy_pending":"Облачная копия пока не подтверждена.","bridge_ready":"Передача подключена."}
seen=False
for line in sys.stdin:
 for key,label in labels.items():
  if key in line.split(): print(label); seen=True; break
if not seen: print("За последний час записей передачи нет. Проверьте состояние и живой обмен.")'
    ;;
subscribe) as_owner subscribe ;;
https)
    domain=$(as_owner domain)
    port=$("$base/venv/bin/python" -c 'import json,sys; print(json.load(open(sys.argv[1]))["port"])' "$data/config.json")
    python3 /usr/local/lib/telemax/project.py https "$project" "$domain" "$port" "$@"
    ;;
https-update)
    [[ -z $project ]] || { echo 'Это общий приёмник всех проектов. Обновляйте его отдельно штатными средствами по инструкции.'; exit 1; }
    [[ -f /etc/systemd/system/telemax-web.service ]] || { echo 'Сначала настройте защищённый адрес.'; exit 1; }
    temp=$(mktemp -d)
    trap 'rm -rf -- "$temp"' EXIT
    apt-get update -qq
    (cd "$temp" && apt-get download caddy >/dev/null)
    dpkg-deb -x "$temp"/caddy_*.deb "$temp/extracted"
    "$temp/extracted/usr/bin/caddy" validate --config /etc/telemax/Caddyfile --adapter caddyfile >/dev/null
    install -m 755 "$temp/extracted/usr/bin/caddy" /opt/telemax/web/usr/bin/caddy.next
    mv -Tf /opt/telemax/web/usr/bin/caddy.next /opt/telemax/web/usr/bin/caddy
    systemctl restart telemax-web
    echo 'Защищённый приём обновлён. Проверьте живой ответ MAX.'
    ;;
update)
    temp=$(mktemp -d)
    trap 'rm -rf -- "$temp"' EXIT
    git clone --quiet --depth 1 --branch main https://github.com/fdrvaa84/telegram-max-bridge.git "$temp/source"
    TELEMAX_INSTALL_LOCKED=1 bash "$temp/source/install.sh" ${project:+--project "$project"} --update
    ;;
rollback)
    [[ -L $root/previous ]] || { echo 'Предыдущая программа не сохранена.'; exit 1; }
    was_active=false
    if systemctl is-active --quiet "$unit"; then was_active=true; fi
    # The installer restores a previously running service even if the new one failed.
    if [[ ${1:-} == --restore-active ]]; then was_active=true; fi
    systemctl stop "$unit"
    ln -s "$(readlink $root/previous)" $root/current.rollback
    mv -Tf $root/current.rollback $root/current
    if [[ $was_active == true ]]; then systemctl start "$unit"; fi
    echo 'Прежняя программа возвращена. Вход, очередь и связь сообщений сохранены.'
    ;;
help|*) echo 'Команды: configure, https, pair, login, start, status, logs, restart, subscribe, update, rollback, stop, clouds, https-update.' ;;
esac
